{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SocialAPIsHub/social-media-api",
  "description": "Facebook & Instagram data for AI agents: pages, posts, groups, ads, Marketplace, profiles, reels.",
  "repository": {
    "url": "https://github.com/SocialAPIsHub/mcp-server",
    "source": "github"
  },
  "version": "2.0.2",
  "homepage": "https://socialapis.io",
  "license": "MIT",
  "tags": [
    "social-media",
    "facebook",
    "instagram",
    "api",
    "data-extraction",
    "analytics",
    "ai-agents",
    "automation"
  ],
  "categories": [
    "data-apis",
    "social-media"
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@socialapis/mcp",
      "version": "2.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SOCIALAPIS_API_KEY",
          "description": "Your SocialAPIs API key. Get yours at https://socialapis.io/dashboard",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "MCP_PROXY_URL",
          "description": "MCP proxy server URL (optional)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://mcp.socialapis.io"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.socialapis.io/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token with your SocialAPIs API key (Authorization: Bearer <key>). Get one at https://socialapis.io/dashboard",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "title": "SocialAPIs",
  "icons": [
    {
      "src": "https://socialapis.io/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ]
}
